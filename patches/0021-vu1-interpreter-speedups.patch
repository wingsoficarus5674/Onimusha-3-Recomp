+namespace
+{
+    // Earliest cycle at which each pipeline queue can have an entry to commit, per
+    // interpreter instance. Kept here rather than as members so ps2_vu1.h (included by
+    // every generated source file) stays unchanged. Conservative: lowered whenever an entry
+    // is queued, recomputed by each scan of that queue.
+    enum Vu1Queue : uint32_t
+    {
+        kQueueFlag = 0,
+        kQueueFdiv,
+        kQueueEfu,
+        kQueueStore,
+        kQueueVf,
+        kQueueVi,
+        kQueueAcc,
+        kQueueCount
+    };
+
+    struct Vu1CommitHint
+    {
+        const void *owner = nullptr;
+        uint64_t next[kQueueCount]{};
+    };
+    // VU execution is serialised by the EE scheduler, so no locking is needed.
+    Vu1CommitHint g_vu1CommitHints[4];
+
+    uint64_t *vu1CommitHintsFor(const void *owner)
+    {
+        for (Vu1CommitHint &hint : g_vu1CommitHints)
+        {
+            if (hint.owner == owner)
+                return hint.next;
+        }
+        for (Vu1CommitHint &hint : g_vu1CommitHints)
+        {
+            if (hint.owner == nullptr)
+            {
+                hint.owner = owner;
+                return hint.next;
+            }
+        }
+        static uint64_t overflow[kQueueCount];
+        for (uint64_t &v : overflow)
+            v = 0; // unknown instance: always scan
+        return overflow;
+    }
+
+    // Resets the XGKICK pipeline without clearing its 64 KB packet buffer: the buffer is
+    // only read up to copiedBytes, which is filled first.
+    template <typename Pipeline>
+    inline void vu1ResetXgkick(Pipeline &xgkick)
+    {
+        xgkick.sourceAddress = 0;
+        xgkick.totalBytes = 0;
+        xgkick.copiedBytes = 0;
+        xgkick.currentTagEnd = 0;
+        xgkick.cycleCredit = 0;
+        xgkick.issueCycle = 0;
+        xgkick.active = false;
+        xgkick.currentTagEop = false;
+    }
+
+    inline void vu1NoteCommitCycle(const void *owner, Vu1Queue queue, uint64_t readyCycle)
+    {
+        uint64_t &next = vu1CommitHintsFor(owner)[queue];
+        if (readyCycle < next)
+            next = readyCycle;
+    }
+}
