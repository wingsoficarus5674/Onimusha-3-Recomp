+namespace
+{
+    // A float that is the single rounding of an exact value, with a biased exponent in
+    // [2, 253], proves the exact value is non-zero, below FLT_MAX and above FLT_MIN, with
+    // the same sign: the exact-result check would only report the sign.
+    inline bool vu1FloatClearlyInRange(float value, uint8_t &signFlag)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        signFlag = (bits & 0x80000000u) != 0u ? 0x2u : 0u;
+        return exponent >= 2u && exponent <= 253u;
+    }
+
+    // r = fl(acc +/- fl(product)) under any rounding mode is within 2^-23 * (|product| + |r|)
+    // of the exact acc +/- product, and |product| <= |r| * (1 + 2^-23) + |acc|. With
+    // |acc| < 2^18 * |r| (no heavy cancellation) the exact value is within ~6% of r, so for
+    // a biased exponent of r in [3, 252] it is non-zero, has r's sign and lies strictly
+    // between FLT_MIN and FLT_MAX: the exact-result check would only report the sign.
+    inline bool vu1ProductSumClearlyInRange(float result, float accOperand, uint8_t &signFlag)
+    {
+        uint32_t bits = 0;
+        uint32_t accBits = 0;
+        std::memcpy(&bits, &result, sizeof(bits));
+        std::memcpy(&accBits, &accOperand, sizeof(accBits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        const uint32_t accExponent = (accBits >> 23) & 0xFFu;
+        signFlag = (bits & 0x80000000u) != 0u ? 0x2u : 0u;
+        return exponent >= 3u && exponent <= 252u && accExponent <= exponent + 17u;
+    }
+
+    // FMAC upper ops whose result is acc +/- product (two roundings in float, so the
+    // fast path above doesn't apply).
+    inline bool vu1IsProductSum(uint32_t upper)
+    {
+        const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+        if (op < 0x3Cu)
+            return (op >= 0x08u && op <= 0x0Fu) || op == 0x21u || op == 0x23u || op == 0x25u ||
+                   op == 0x27u || op == 0x29u || op == 0x2Du || op == 0x2Eu;
+        const uint8_t special = static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu));
+        return (special >= 0x08u && special <= 0x0Fu) || special == 0x21u || special == 0x23u ||
+               special == 0x25u || special == 0x27u || special == 0x29u || special == 0x2Du;
+    }
+}
