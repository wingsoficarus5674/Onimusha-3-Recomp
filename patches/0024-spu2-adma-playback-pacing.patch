diff --git a/ps2xIOP/src/emulator/core/iop_memory.cpp b/ps2xIOP/src/emulator/core/iop_memory.cpp
index 25e9b36..0c0fc0d 100644
--- a/ps2xIOP/src/emulator/core/iop_memory.cpp
+++ b/ps2xIOP/src/emulator/core/iop_memory.cpp
@@ -269,9 +269,26 @@ namespace ps2x::iop::detail
         const uint32_t wordsPerBlock = std::max<uint32_t>(blockControl & 0xFFFFu, 1u);
         const uint32_t blockCount = std::max<uint32_t>(blockControl >> 16u, 1u);
         const uint64_t transferWords = static_cast<uint64_t>(wordsPerBlock) * blockCount;
+        uint64_t delayCycles = std::max<uint64_t>(transferWords * 2u, 64u);
+        // AutoDMA (ADMA) streams feed the SPU2's sound-data input, which takes 512 bytes per
+        // channel for every 256 stereo samples at 48 kHz, i.e. 192000 bytes per second.
+        // Completing such a transfer at that rate (rather than at memory speed) keeps
+        // streaming drivers such as CRI's ADX decoder running at playback speed instead of
+        // decoding thousands of blocks a second.
+        const uint32_t admaStatusAddress = secondCore ? 0x1F9005B0u : 0x1F9001B0u;
+        uint32_t admaWord = 0u;
+        if (const auto current = m_hardware.find(admaStatusAddress & ~3u); current != m_hardware.end())
+            admaWord = current->second;
+        const uint32_t admaStatus = (admaWord >> ((admaStatusAddress & 2u) * 8u)) & 0xFFFFu;
+        if (admaStatus != 0u)
+        {
+            constexpr uint64_t kIopClockHz = 36864000ull;
+            constexpr uint64_t kAdmaBytesPerSecond = 192000ull;
+            delayCycles = std::max<uint64_t>(delayCycles, transferWords * 4u * kIopClockHz / kAdmaBytesPerSecond);
+        }
         m_dmaStart = DmaStart{
             secondCore ? kDmaSpu1Irq : kDmaSpu0Irq,
-            std::max<uint64_t>(transferWords * 2u, 64u),
+            delayCycles,
         };
     }
 
