+    // This emulator implements the IOP kernel at a high level and installs no exception
+    // handler at the vector. Raising an address error there would run ~16K NOPs into whatever
+    // module code comes first, so without a handler a misaligned load/store is done at the
+    // aligned address instead (and reported).
+    bool IopCpuCore::exceptionHandlerInstalled() const
+    {
+        return m_memory.read32(0x80000080u) != 0u;
+    }
+
+    uint32_t IopCpuCore::alignAfterAddressError(uint32_t address, uint32_t mask, uint32_t pc, uint32_t code) const
