     void IopEmulator::runEeCycles(uint64_t eeCycles) noexcept
     {
+        // The EE scheduler reports elapsed time at every loop back-edge and call (8-32 EE
+        // cycles, i.e. 1-4 IOP cycles). Running the IOP for each of those spent most of the
+        // time in per-call bookkeeping, so time is batched into slices of kIopBatchCycles
+        // (about 14 us of PS2 time; far below anything the EE can observe).
+        constexpr uint64_t kIopBatchCycles = 512u;
         const uint64_t total = m_impl->eeCycleCarry + eeCycles;
         const uint64_t iopCycles = total / 8u;
+        if (iopCycles < kIopBatchCycles)
+        {
+            m_impl->eeCycleCarry = total;
+            return;
+        }
         m_impl->eeCycleCarry = total % 8u;
-        if (iopCycles)
-            m_impl->runCycles(iopCycles);
+        m_impl->runCycles(iopCycles);
     }
 
