+        {
+            if (bits.peek(e.length) == e.code)
+            {
+                bits.skip(e.length);
+                return &e;
+            }
+        }
+        return nullptr;
+    }
+
+    void inverseDct(const int32_t in[64], float out[64])
+    {
+        const Tables &t = tables();
+        float tmp[64];
+        for (int v = 0; v < 8; ++v)
+        {
+            for (int x = 0; x < 8; ++x)
+            {
+                float s = 0.0f;
+                for (int u = 0; u < 8; ++u)
+                {
+                    s += t.idct[u][x] * static_cast<float>(in[v * 8 + u]);
+                }
+                tmp[v * 8 + x] = s;
+            }
+        }
+        for (int y = 0; y < 8; ++y)
+        {
+            for (int x = 0; x < 8; ++x)
+            {
+                float s = 0.0f;
+                for (int v = 0; v < 8; ++v)
+                {
+                    s += t.idct[v][y] * tmp[v * 8 + x];
+                }
+                out[y * 8 + x] = s;
+            }
+        }
+    }
+
+    uint8_t clampByte(float v)
+    {
+        const int i = static_cast<int>(std::lround(v));
+        return static_cast<uint8_t>(i < 0 ? 0 : (i > 255 ? 255 : i));
+    }
