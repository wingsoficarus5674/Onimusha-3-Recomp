+            b14 = buildTable(kB14ShortCodes, kB14ShortValues, sizeof(kB14ShortCodes) / sizeof(kB14ShortCodes[0]));
+            VlcTable longCodes = buildTable(kLongCodes, kLongValues, sizeof(kLongCodes) / sizeof(kLongCodes[0]));
+            b14.entries.insert(b14.entries.end(), longCodes.entries.begin(), longCodes.entries.end());
