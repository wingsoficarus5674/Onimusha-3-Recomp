+            while (bits.peek(11) == 0x8u)
+            {
+                bits.skip(11);
+                increment += 33;
+            }
+            if (bits.peek(1) != 1u)
+            {
+                break; // stills only use an increment of 1
+            }
+            bits.skip(1);
+            increment += 1;
+            if (increment != 1)
+            {
+                dcPred[0] = dcPred[1] = dcPred[2] = dcReset;
+            }
+        }
+
+        bool quant = false;
+        if (bits.get(1) == 1u)
+        {
+            quant = false;
+        }
+        else if (bits.get(1) == 1u)
+        {
+            quant = true;
+        }
+        else
+        {
+            break; // not an intra macroblock
+        }
+        const bool fieldDct = params.dctTypeDecode ? (bits.get(1) != 0u) : false;
+        if (quant)
+        {
+            qCode = bits.get(5);
+        }
+        const int qScale = params.nonLinearQScale ? kNonLinearQScale[qCode & 31u] : static_cast<int>(qCode) * 2;
+
+        bool ok = true;
+        for (int b = 0; b < 6 && ok; ++b)
+        {
+            const int cc = (b < 4) ? 0 : b - 3;
+            const VlcEntry *dc = decodeVlc(bits, cc == 0 ? t.dcLuma : t.dcChroma);
+            if (dc == nullptr)
+            {
+                ok = false;
+                break;
+            }
+            const unsigned dcSize = dc->level;
+            int diff = 0;
+            if (dcSize != 0)
+            {
+                const int v = static_cast<int>(bits.get(dcSize));
+                diff = (v >= (1 << (dcSize - 1))) ? v : v - (1 << dcSize) + 1;
+            }
+            dcPred[cc] += diff;
+
+            int32_t coef[64];
+            std::memset(coef, 0, sizeof(coef));
+            coef[0] = dcPred[cc] * dcMult;
+            int sum = coef[0];
+            int index = 0;
+            for (;;)
+            {
+                if (bits.peek(eobLength) == eobCode)
+                {
+                    bits.skip(eobLength);
+                    break;
+                }
+                int run = 0;
+                int level = 0;
+                if (bits.peek(6) == 0x1u)
+                {
+                    bits.skip(6);
+                    run = static_cast<int>(bits.get(6));
+                    if (params.mpeg1)
+                    {
+                        level = static_cast<int>(bits.get(8));
+                        if (level == 0)
+                            level = static_cast<int>(bits.get(8));
+                        else if (level == 128)
+                            level = static_cast<int>(bits.get(8)) - 256;
+                        else if (level > 128)
+                            level -= 256;
+                    }
+                    else
+                    {
+                        level = static_cast<int>(bits.get(12));
+                        if (level & 0x800)
+                            level -= 0x1000;
+                    }
+                }
+                else
+                {
+                    const VlcEntry *e = decodeVlc(bits, acTable);
+                    if (e == nullptr)
+                    {
+                        ok = false;
+                        break;
+                    }
+                    run = e->run;
+                    level = bits.get(1) ? -static_cast<int>(e->level) : static_cast<int>(e->level);
+                }
+                index += run + 1;
+                if (index > 63)
+                {
+                    ok = false;
+                    break;
+                }
+                const int pos = scan[index];
+                const int magnitude = (std::abs(level) * matrix[pos] * qScale) / 16;
+                int value = (level < 0) ? -magnitude : magnitude;
+                if (params.mpeg1 && value != 0 && (value & 1) == 0)
+                {
+                    value += (value > 0) ? -1 : 1; // MPEG-1 oddification
+                }
+                value = std::max(-2048, std::min(2047, value));
+                coef[pos] = value;
+                sum += value;
+            }
+            if (!ok)
+            {
+                break;
+            }
+            if (!params.mpeg1 && (sum & 1) == 0)
+            {
+                coef[63] ^= 1; // MPEG-2 mismatch control
+            }
+            inverseDct(coef, blocks[b]);
+        }
+        if (!ok)
+        {
+            break;
+        }
+
+        for (int y = 0; y < 16; ++y)
+        {
+            for (int x = 0; x < 16; ++x)
+            {
+                int by = y & 7;
+                int blockIndex = ((y >> 3) & 1) * 2 + (x >> 3);
+                if (fieldDct)
+                {
+                    blockIndex = (y & 1) * 2 + (x >> 3);
+                    by = y >> 1;
+                }
+                const float luma = blocks[blockIndex][by * 8 + (x & 7)];
+                const float cb = blocks[4][(y >> 1) * 8 + (x >> 1)] - 128.0f;
+                const float cr = blocks[5][(y >> 1) * 8 + (x >> 1)] - 128.0f;
+                const float l = 1.164f * (luma - 16.0f);
+                uint8_t *p = rgba + (y * 16 + x) * 4;
+                p[0] = clampByte(l + 1.596f * cr);
+                p[1] = clampByte(l - 0.392f * cb - 0.813f * cr);
+                p[2] = clampByte(l + 2.017f * cb);
+                p[3] = 0x80;
+                if (params.threshold0 > 0 && p[0] < params.threshold0 && p[1] < params.threshold0 &&
+                    p[2] < params.threshold0)
+                {
+                    p[0] = p[1] = p[2] = p[3] = 0;
+                }
+                else if (params.threshold1 > 0 && p[0] < params.threshold1 && p[1] < params.threshold1 &&
+                         p[2] < params.threshold1)
+                {
+                    p[3] = 0x40;
+                }
+            }
+        }
+        out(decoded, rgba);
+    }
+    return decoded;
+}
