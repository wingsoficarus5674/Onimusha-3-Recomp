@@ -0,0 +1,29 @@
+#pragma once
+
+// Software IPU IDEC: decodes intra-coded MPEG-1/2 macroblocks (the bitstream the IPU's
+// IDEC command consumes) and converts them to 16x16 RGB32 macroblocks like the IPU's CSC.
+// Used to stand in for IPU still-image decoders, since the IPU itself is not emulated.
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+
+struct IpuIdecParams
+{
+    uint8_t intraDcPrecision = 0;  // IPU_CTRL.IDP
+    bool alternateScan = false;    // IPU_CTRL.AS
+    bool intraVlcFormat = false;   // IPU_CTRL.IVF (table B-15 instead of B-14)
+    bool nonLinearQScale = false;  // IPU_CTRL.QST
+    bool mpeg1 = false;            // IPU_CTRL.MP1
+    bool dctTypeDecode = false;    // IDEC.DTD
+    uint8_t quantiserScaleCode = 1;// IDEC.QSC
+    uint16_t threshold0 = 0;       // SETTH TH0 (transparent below)
+    uint16_t threshold1 = 0;       // SETTH TH1 (semi-transparent below)
+    const uint8_t *intraMatrix = nullptr; // 64 entries in raster order; nullptr = MPEG default
+};
+
+// Decodes up to maxMacroblocks macroblocks from data and calls out(index, rgba) for each one,
+// where rgba holds 16x16 pixels of R,G,B,A in raster order (1024 bytes).
+// Stops early at a start code or on a bitstream error. Returns the number decoded.
+size_t ipuIdecDecode(const uint8_t *data, size_t size, const IpuIdecParams &params, size_t maxMacroblocks,
+                     const std::function<void(size_t, const uint8_t *)> &out);
