+// ---------------------------------------------------------------------------------------
+// Asynchronous VIF1 (see runtime/ps2_vif1_async.h)
+// ---------------------------------------------------------------------------------------
+namespace ps2_vif1_async
+{
+    namespace
+    {
+        struct Worker
+        {
+            std::mutex mutex;
+            std::condition_variable wake;
+            std::condition_variable idle;
+            std::deque<std::function<void()>> jobs;
+            std::thread thread;
+            uint64_t submitted = 0;   // under mutex
+            uint64_t finished = 0;    // under mutex
+            std::atomic<uint64_t> submittedCount{0};
+            std::atomic<uint64_t> takenCount{0};
+            bool running = false;
+
+            void loop()
+            {
+                tl_onWorker = true;
+                for (;;)
+                {
+                    std::function<void()> job;
+                    {
+                        std::unique_lock<std::mutex> lock(mutex);
+                        wake.wait(lock, [this]()
+                                  { return !jobs.empty(); });
+                        job = std::move(jobs.front());
+                        jobs.pop_front();
+                    }
+                    job();
+                    {
+                        std::lock_guard<std::mutex> lock(mutex);
+                        ++finished;
+                    }
+                    idle.notify_all();
+                }
+            }
+
+            static thread_local bool tl_onWorker;
+        };
+        thread_local bool Worker::tl_onWorker = false;
+
+        Worker &worker()
+        {
+            // Never destroyed: the thread blocks forever when the program exits.
+            static Worker *instance = []()
+            {
+                Worker *w = new Worker();
+                w->thread = std::thread([w]()
+                                        { w->loop(); });
+                w->thread.detach();
+                return w;
+            }();
+            return *instance;
+        }
+    }
+
+    bool enabled()
+    {
+        static const bool on = std::getenv("PS2X_VIF1_SYNC") == nullptr;
+        return on;
+    }
+
+    bool onWorkerThread()
+    {
+        return Worker::tl_onWorker;
+    }
+
+    void submit(std::function<void()> job)
+    {
+        Worker &w = worker();
+        {
+            std::lock_guard<std::mutex> lock(w.mutex);
+            w.jobs.push_back(std::move(job));
+            ++w.submitted;
+            w.submittedCount.fetch_add(1u, std::memory_order_release);
+        }
+        w.wake.notify_one();
+    }
+
+    bool unsettled()
+    {
+        if (!enabled())
+            return false;
+        // Cheap check for the hot paths: nothing submitted that hasn't been taken.
+        Worker &w = worker();
+        return w.submittedCount.load(std::memory_order_acquire) != w.takenCount.load(std::memory_order_acquire);
+    }
+
+    void waitIdle()
+    {
+        if (!enabled() || Worker::tl_onWorker)
+            return;
+        Worker &w = worker();
+        std::unique_lock<std::mutex> lock(w.mutex);
+        w.idle.wait(lock, [&w]()
+                    { return w.finished == w.submitted; });
+    }
+
+    uint32_t takeCompleted()
+    {
+        if (!enabled())
+            return 0u;
+        Worker &w = worker();
+        uint64_t finished = 0;
+        {
+            std::lock_guard<std::mutex> lock(w.mutex);
+            finished = w.finished;
+        }
+        const uint64_t taken = w.takenCount.load(std::memory_order_acquire);
+        if (finished <= taken)
+            return 0u;
+        w.takenCount.store(finished, std::memory_order_release);
+        return static_cast<uint32_t>(finished - taken);
+    }
+}
