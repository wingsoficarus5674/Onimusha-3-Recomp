index 0000000..b3c98f2
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_vif1_async.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+
+// VIF1 DMA (and the VU1 microprograms and GS packets it starts) can run on a worker thread,
+// alongside the EE, as it does on the real hardware. The EE side waits for the worker at
+// every point where it could observe the work: VIF/GIF/DMA registers, VU1 memory, GS
+// registers and the GS entry points the runtime's stubs use. Set PS2X_VIF1_SYNC=1 to run
+// VIF1 on the EE thread instead.
+namespace ps2_vif1_async
+{
+    bool enabled();
+    bool onWorkerThread();
+
+    // Runs the job on the worker, after every job submitted before it.
+    void submit(std::function<void()> job);
+
+    // True while a submitted job hasn't been accounted for by takeCompleted().
+    bool unsettled();
+
+    // Waits until every submitted job has finished. Does nothing on the worker thread.
+    void waitIdle();
+
+    // Number of jobs that finished since the last call.
+    uint32_t takeCompleted();
+}
