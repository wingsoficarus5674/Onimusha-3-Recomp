diff --git a/ps2xRuntime/include/ps2_overlays.h b/ps2xRuntime/include/ps2_overlays.h
new file mode 100644
index 0000000..8de79cb
--- /dev/null
+++ b/ps2xRuntime/include/ps2_overlays.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// Recompiled code overlays.
+//
+// Some games load extra code into RAM at run time (Capcom's "LINK" modules, for
+// example), often several different modules at the same address over the course
+// of a game. Each module is recompiled separately and registers itself here. When
+// the runtime dispatches to an address outside the main function table, it asks
+// which registered module is resident there right now (by comparing the module's
+// signature bytes with RAM) and uses that module's recompiled function.
+
+#include <cstddef>
+#include <cstdint>
+
+#include "ps2_runtime.h"
+
+struct PS2OverlayFunction
+{
+    uint32_t address; // function entry or resume label
+    PS2Runtime::RecompiledFunction function;
+};
+
+struct PS2OverlayModule
+{
+    const char *name;
+    uint32_t loadAddress;                 // address the module image is linked and loaded at
+    uint32_t imageSize;                   // bytes covered by the module image
+    const uint8_t *signature;             // bytes expected at loadAddress while the module is resident
+    uint32_t signatureSize;
+    const PS2OverlayFunction *functions;  // sorted by address
+    size_t functionCount;
+};
+
+// Called from static initializers in generated overlay sources.
+void ps2xRegisterOverlayModule(const PS2OverlayModule *module);
+
+// Returns the recompiled function for address in the module currently resident
+// there, or nullptr.
+PS2Runtime::RecompiledFunction ps2xFindOverlayFunction(const uint8_t *rdram, uint32_t address);
diff --git a/ps2xRuntime/src/lib/ps2_overlays.cpp b/ps2xRuntime/src/lib/ps2_overlays.cpp
new file mode 100644
index 0000000..8fc9893
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_overlays.cpp
@@ -0,0 +1,81 @@
+#include "ps2_overlays.h"
+
+#include <algorithm>
+#include <cstring>
+#include <vector>
+
+namespace
+{
+    std::vector<const PS2OverlayModule *> &overlayRegistry()
+    {
+        static std::vector<const PS2OverlayModule *> modules;
+        return modules;
+    }
+
+    bool isResidentAt(const uint8_t *rdram, const PS2OverlayModule *module, uint32_t address)
+    {
+        if (address < module->loadAddress || address - module->loadAddress >= module->imageSize)
+        {
+            return false;
+        }
+        if (static_cast<uint64_t>(module->loadAddress) + module->signatureSize > PS2_RAM_SIZE)
+        {
+            return false;
+        }
+        return std::memcmp(rdram + module->loadAddress, module->signature, module->signatureSize) == 0;
+    }
+}
+
+void ps2xRegisterOverlayModule(const PS2OverlayModule *module)
+{
+    if (module != nullptr)
+    {
+        overlayRegistry().push_back(module);
+    }
+}
+
+PS2Runtime::RecompiledFunction ps2xFindOverlayFunction(const uint8_t *rdram, uint32_t address)
+{
+    const std::vector<const PS2OverlayModule *> &modules = overlayRegistry();
+    if (rdram == nullptr || modules.empty())
+    {
+        return nullptr;
+    }
+
+    address &= 0x1FFFFFFFu;
+
+    // Most lookups hit the module that answered last time.
+    thread_local const PS2OverlayModule *s_lastModule = nullptr;
+    const PS2OverlayModule *module = nullptr;
+    if (s_lastModule != nullptr && isResidentAt(rdram, s_lastModule, address))
+    {
+        module = s_lastModule;
+    }
+    else
+    {
+        for (const PS2OverlayModule *candidate : modules)
+        {
+            if (isResidentAt(rdram, candidate, address))
+            {
+                module = candidate;
+                break;
+            }
+        }
+    }
+    if (module == nullptr)
+    {
+        return nullptr;
+    }
+    s_lastModule = module;
+
+    const PS2OverlayFunction *begin = module->functions;
+    const PS2OverlayFunction *end = module->functions + module->functionCount;
+    const PS2OverlayFunction *it = std::lower_bound(begin, end, address,
+                                                    [](const PS2OverlayFunction &entry, uint32_t value)
+                                                    { return entry.address < value; });
+    if (it == end || it->address != address)
+    {
+        return nullptr;
+    }
+    return it->function;
+}
