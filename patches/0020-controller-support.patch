+    // adapters and DirectInput pads: 0 Triangle, 1 Circle, 2 Cross, 3 Square,
+    // 4 L2, 5 R2, 6 L1, 7 R1, 8 Select, 9 Start, 10 L3, 11 R3; first hat = D-pad;
