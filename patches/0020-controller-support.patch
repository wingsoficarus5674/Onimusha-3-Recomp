diff --git a/ps2xRuntime/include/runtime/ps2_pad_host.h b/ps2xRuntime/include/runtime/ps2_pad_host.h
new file mode 100644
index 0000000..70ff00c
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_pad_host.h
@@ -0,0 +1,19 @@
+#ifndef PS2_PAD_HOST_H
+#define PS2_PAD_HOST_H
+
+// Host controller support for PSPadBackend (see ps2_pad.cpp).
+//
+// Every controller the host sees is used. Controllers known to SDL's GameControllerDB
+// (Xbox, PlayStation, Switch, 8BitDo, Logitech, generic USB pads, PS2-to-USB adapters,
+// ...) get a standard layout; gamecontrollerdb.txt and an optional
+// gamecontrollerdb_user.txt next to the executable or in the working folder are loaded
+// at start-up. Devices without a mapping fall back to the raw layout of PS2-to-USB
+// adapters. The first controller (plus the keyboard) is port 1, the second is port 2.
+//
+// ps2PadHostInit() and ps2PadHostPoll() run on the window (main) thread; PSPadBackend
+// readState() on the game thread only reads the snapshot taken by the last poll.
+void ps2PadHostInit();
+void ps2PadHostPoll();
+bool ps2PadHostConnected(int port);
+
+#endif
