+    float applyDeadzone(float v)
+    {
+        if (!std::isfinite(v))
+            return 0.0f;
+        v = std::clamp(v, -1.0f, 1.0f);
+        const float a = std::fabs(v);
+        if (a < kStickDeadzone)
+            return 0.0f;
+        const float scaled = (a - kStickDeadzone) / (1.0f - kStickDeadzone);
+        return v < 0.0f ? -scaled : scaled;
+    }
+
+    uint8_t axisToByte(float v)
+    {
+        v = std::clamp(v, -1.0f, 1.0f);
+        return static_cast<uint8_t>(std::lround((v + 1.0f) * 127.5f));
+    }
+
+    // Trigger axes run from -1 (released) to +1 (fully pressed).
+    float triggerToUnit(float v)
+    {
+        if (!std::isfinite(v))
+            return 0.0f;
+        v = std::clamp(v, -1.0f, 1.0f);
+        return (v + 1.0f) * 0.5f;
+    }
