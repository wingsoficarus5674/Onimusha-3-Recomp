+    void readKeyboard(HostPad &pad)
+    {
+        auto set = [&pad](uint16_t mask, bool on)
+        { if (on) pad.pressed |= mask; };
+        set(PAD_UP, IsKeyDown(KEY_UP) || IsKeyDown(KEY_W));
+        set(PAD_DOWN, IsKeyDown(KEY_DOWN) || IsKeyDown(KEY_S));
+        set(PAD_LEFT, IsKeyDown(KEY_LEFT) || IsKeyDown(KEY_A));
+        set(PAD_RIGHT, IsKeyDown(KEY_RIGHT) || IsKeyDown(KEY_D));
+        set(PAD_CROSS, IsKeyDown(KEY_X) || IsKeyDown(KEY_SPACE));
+        set(PAD_CIRCLE, IsKeyDown(KEY_C) || IsKeyDown(KEY_ESCAPE));
+        set(PAD_SQUARE, IsKeyDown(KEY_Z) || IsKeyDown(KEY_KP_0));
+        set(PAD_TRIANGLE, IsKeyDown(KEY_V) || IsKeyDown(KEY_KP_1));
+        set(PAD_L1, IsKeyDown(KEY_Q));
+        set(PAD_R1, IsKeyDown(KEY_E));
+        set(PAD_L2, IsKeyDown(KEY_LEFT_SHIFT));
+        set(PAD_R2, IsKeyDown(KEY_RIGHT_SHIFT));
+        set(PAD_START, IsKeyDown(KEY_ENTER));
+        set(PAD_SELECT, IsKeyDown(KEY_TAB));
+        set(PAD_L3, IsKeyDown(KEY_LEFT_CONTROL));
+        set(PAD_R3, IsKeyDown(KEY_RIGHT_CONTROL));
+        if (pad.pressed & PAD_L2)
+            pad.l2 = 1.0f;
+        if (pad.pressed & PAD_R2)
+            pad.r2 = 1.0f;
+    }
+
+    // Combine several sources: buttons OR'd, the stick/trigger with the largest deflection wins.
+    void mergeInto(HostPad &dst, const HostPad &src)
+    {
+        dst.pressed |= src.pressed;
+        auto pick = [](float a, float b)
+        { return std::fabs(b) > std::fabs(a) ? b : a; };
+        dst.lx = pick(dst.lx, applyDeadzone(src.lx));
+        dst.ly = pick(dst.ly, applyDeadzone(src.ly));
+        dst.rx = pick(dst.rx, applyDeadzone(src.rx));
+        dst.ry = pick(dst.ry, applyDeadzone(src.ry));
+        dst.l2 = std::max(dst.l2, src.l2);
+        dst.r2 = std::max(dst.r2, src.r2);
+    }
+
+    void toSnapshotFields(const HostPad &pad, uint16_t &buttons, uint8_t &rx, uint8_t &ry,
+                          uint8_t &lx, uint8_t &ly, uint8_t (&pressure)[12])
+    {
+        uint16_t pressed = pad.pressed;
+        if (pad.l2 >= kTriggerThreshold)
+            pressed |= PAD_L2;
+        if (pad.r2 >= kTriggerThreshold)
+            pressed |= PAD_R2;
+        buttons = static_cast<uint16_t>(~pressed);
+        lx = axisToByte(pad.lx);
+        ly = axisToByte(pad.ly);
+        rx = axisToByte(pad.rx);
+        ry = axisToByte(pad.ry);
+        for (int i = 0; i < 12; ++i)
+            pressure[i] = (pressed & kPressureOrder[i]) ? 0xFFu : 0x00u;
+        if (pressed & PAD_L2)
+            pressure[kPressureL2] = static_cast<uint8_t>(std::lround(std::clamp(pad.l2, 0.0f, 1.0f) * 255.0f));
+        if (pressed & PAD_R2)
+            pressure[kPressureR2] = static_cast<uint8_t>(std::lround(std::clamp(pad.r2, 0.0f, 1.0f) * 255.0f));
+    }
