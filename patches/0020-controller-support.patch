+    void readMappedPad(int gamepad, HostPad &pad)
+    {
+        auto down = [gamepad](int button)
+        { return IsGamepadButtonDown(gamepad, button); };
+        auto set = [&pad](uint16_t mask, bool on)
+        { if (on) pad.pressed |= mask; };
+
+        // Positional layout: the bottom face button is Cross on every controller
+        // (A on Xbox, B on Nintendo), right = Circle, left = Square, top = Triangle.
+        set(PAD_UP, down(GAMEPAD_BUTTON_LEFT_FACE_UP));
+        set(PAD_DOWN, down(GAMEPAD_BUTTON_LEFT_FACE_DOWN));
+        set(PAD_LEFT, down(GAMEPAD_BUTTON_LEFT_FACE_LEFT));
+        set(PAD_RIGHT, down(GAMEPAD_BUTTON_LEFT_FACE_RIGHT));
+        set(PAD_CROSS, down(GAMEPAD_BUTTON_RIGHT_FACE_DOWN));
+        set(PAD_CIRCLE, down(GAMEPAD_BUTTON_RIGHT_FACE_RIGHT));
+        set(PAD_SQUARE, down(GAMEPAD_BUTTON_RIGHT_FACE_LEFT));
+        set(PAD_TRIANGLE, down(GAMEPAD_BUTTON_RIGHT_FACE_UP));
+        set(PAD_L1, down(GAMEPAD_BUTTON_LEFT_TRIGGER_1));
+        set(PAD_R1, down(GAMEPAD_BUTTON_RIGHT_TRIGGER_1));
+        set(PAD_L3, down(GAMEPAD_BUTTON_LEFT_THUMB));
+        set(PAD_R3, down(GAMEPAD_BUTTON_RIGHT_THUMB));
+        set(PAD_SELECT, down(GAMEPAD_BUTTON_MIDDLE_LEFT));
+        set(PAD_START, down(GAMEPAD_BUTTON_MIDDLE_RIGHT));
+
+        pad.lx = GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_LEFT_X);
+        pad.ly = GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_LEFT_Y);
+        pad.rx = GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_RIGHT_X);
+        pad.ry = GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_RIGHT_Y);
+
+        // Analog triggers (Xbox, DualShock 4, DualSense) report an axis; digital ones
+        // (Switch, many generic pads) only a button.
+        pad.l2 = triggerToUnit(GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_LEFT_TRIGGER));
+        pad.r2 = triggerToUnit(GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_RIGHT_TRIGGER));
+        if (down(GAMEPAD_BUTTON_LEFT_TRIGGER_2))
+            pad.l2 = std::max(pad.l2, 1.0f);
+        if (down(GAMEPAD_BUTTON_RIGHT_TRIGGER_2))
+            pad.r2 = std::max(pad.r2, 1.0f);
+    }
