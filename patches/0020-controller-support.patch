+
+static void pollDirect(PortSnapshot (&ports)[kMaxPorts])
+{
+    HostPad merged[kMaxPorts];
+    bool connected[kMaxPorts] = {true, false}; // port 1 always has the keyboard
+
+    int nextPort = 0;
+    for (int i = 0; i < kHostPadCount && nextPort < kMaxPorts; ++i)
+    {
+        if (!IsGamepadAvailable(i))
+        {
+            if (!g_lastNames[i].empty())
+            {
+                std::fprintf(stderr, "[pad] controller %d disconnected: %s\n", i + 1, g_lastNames[i].c_str());
+                g_lastNames[i].clear();
+            }
+            continue;
+        }
+
+        HostPad pad;
+        bool mapped = true;
+#if defined(PS2X_PAD_HAVE_GLFW)
+        mapped = glfwJoystickIsGamepad(GLFW_JOYSTICK_1 + i) == GLFW_TRUE;
+        if (!mapped)
+            readRawJoystick(GLFW_JOYSTICK_1 + i, pad);
+#endif
+        if (mapped)
+            readMappedPad(i, pad);
+
+        const char *name = GetGamepadName(i);
+        const std::string label = name ? name : "controller";
+        if (g_lastNames[i] != label)
+        {
+            g_lastNames[i] = label;
+            std::fprintf(stderr, "[pad] controller %d connected: %s (%s) -> PS2 port %d\n", i + 1, label.c_str(),
+                         mapped ? "mapped" : "no mapping, generic layout", nextPort + 1);
+        }
+
+        mergeInto(merged[nextPort], pad);
+        connected[nextPort] = true;
+        ++nextPort;
+    }
+
+    HostPad keyboard;
+    readKeyboard(keyboard);
+    merged[0].pressed |= keyboard.pressed;
+    merged[0].l2 = std::max(merged[0].l2, keyboard.l2);
+    merged[0].r2 = std::max(merged[0].r2, keyboard.r2);
+
+    for (int p = 0; p < kMaxPorts; ++p)
+    {
+        PortSnapshot &s = ports[p];
+        s.connected = connected[p];
+        toSnapshotFields(merged[p], s.buttons, s.rx, s.ry, s.lx, s.ly, s.pressure);
+    }
+}
+
+void ps2PadHostPoll()
+{
+    if (!IsWindowReady())
+        return;
+    if (!g_hostReady)
+        ps2PadHostInit();
+    PortSnapshot ports[kMaxPorts];
+    pollDirect(ports);
+    std::lock_guard<std::mutex> lock(g_padMutex);
+    for (int p = 0; p < kMaxPorts; ++p)
+        g_ports[p] = ports[p];
+    g_polled = true;
+}
+
+bool ps2PadHostConnected(int port)
+{
+    if (port < 0 || port >= kMaxPorts)
         return false;
+    std::lock_guard<std::mutex> lock(g_padMutex);
+    return port == 0 || (g_polled && g_ports[port].connected);
+}
 
