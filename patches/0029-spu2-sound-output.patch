+#if !defined(PLATFORM_VITA)
+namespace
+{
+    // Host playback of the IOP's SPU2 output (48 kHz stereo). The IOP produces samples in
+    // emulated time, which drifts from real time, so the consumer resamples slightly to
+    // keep about 50 ms buffered, and falls silent (then refills) on a real underrun.
+    std::atomic<ps2x::iop::IopSubsystem *> g_spu2AudioSource{nullptr};
+    AudioStream g_spu2Stream{};
+    bool g_spu2StreamLoaded = false;
+
+    void spu2AudioCallback(void *buffer, unsigned int frames)
+    {
+        static bool started = false;
+        static double frac = 0.0;
+        static int16_t cur[2] = {0, 0};
+        static int16_t nxt[2] = {0, 0};
+        int16_t *out = static_cast<int16_t *>(buffer);
+        ps2x::iop::IopSubsystem *source = g_spu2AudioSource.load(std::memory_order_acquire);
+        if (!source)
+        {
+            std::memset(out, 0, static_cast<size_t>(frames) * 4u);
+            return;
+        }
+        constexpr double kTarget = 2400.0;
+        const double available = static_cast<double>(source->audioFramesAvailable());
+        if (!started)
+        {
+            if (available < kTarget)
+            {
+                std::memset(out, 0, static_cast<size_t>(frames) * 4u);
+                return;
+            }
+            started = true;
+        }
+        const double ratio = 1.0 + std::clamp((available - kTarget) / kTarget, -0.15, 0.15);
+        for (unsigned int i = 0; i < frames; ++i)
+        {
+            frac += ratio;
+            while (frac >= 1.0)
+            {
+                frac -= 1.0;
+                cur[0] = nxt[0];
+                cur[1] = nxt[1];
+                int16_t frame[2];
+                if (source->readAudio(frame, 1u) == 1u)
+                {
+                    nxt[0] = frame[0];
+                    nxt[1] = frame[1];
+                }
+                else
+                {
+                    started = false;
+                    nxt[0] = static_cast<int16_t>(nxt[0] / 2);
+                    nxt[1] = static_cast<int16_t>(nxt[1] / 2);
+                }
+            }
+            out[i * 2u] = static_cast<int16_t>(cur[0] + (nxt[0] - cur[0]) * frac);
+            out[i * 2u + 1u] = static_cast<int16_t>(cur[1] + (nxt[1] - cur[1]) * frac);
+        }
+    }
+}
