diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
new file mode 100644
index 0000000..4a00554
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,129 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // Lock-free single-producer/single-consumer ring of interleaved stereo int16 frames.
+    // The IOP (EE thread) produces; the host audio callback consumes.
+    class Spu2OutputRing
+    {
+    public:
+        static constexpr size_t kFrames = 1u << 15u; // ~0.68 s at 48 kHz
+
+        void push(int16_t left, int16_t right) noexcept;
+        size_t pop(int16_t *interleaved, size_t frames) noexcept;
+        [[nodiscard]] size_t available() const noexcept;
+        void clear() noexcept;
+
+    private:
+        std::array<int16_t, kFrames * 2u> m_data{};
+        std::atomic<size_t> m_write{0};
+        std::atomic<size_t> m_read{0};
+    };
+
+    // PlayStation 2 SPU2: two cores of 24 ADPCM voices, 2 MB sound RAM, the AutoDMA
+    // (ADMA) PCM input used by streamed audio, and the stereo mix of both cores.
+    // Reverb is not emulated.
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t kRegBase = 0x1F900000u;
+        static constexpr uint32_t kRegSize = 0x800u;
+        static constexpr uint32_t kRamHalfwords = 1u << 20u; // 2 MB
+        static constexpr uint32_t kCyclesPerSample = 768u;   // 36.864 MHz / 48 kHz
+
+        Spu2();
+        void reset();
+
+        [[nodiscard]] static bool isRegister(uint32_t phys) noexcept
+        {
+            return phys >= kRegBase && phys < kRegBase + kRegSize;
+        }
+
+        [[nodiscard]] uint16_t read16(uint32_t offset);
+        void write16(uint32_t offset, uint16_t value);
+
+        // Value of a register as last written (no side effects).
+        [[nodiscard]] uint16_t raw16(uint32_t offset) const noexcept { return m_regs[(offset & (kRegSize - 1u)) >> 1u]; }
+        void setRaw16(uint32_t offset, uint16_t value) noexcept { m_regs[(offset & (kRegSize - 1u)) >> 1u] = value; }
+
+        // DMA between IOP RAM and sound RAM (or the ADMA input when the core's ADMAS bit is set).
+        void dmaWrite(int core, const uint8_t *source, size_t bytes);
+        void dmaRead(int core, uint8_t *destination, size_t bytes);
+        // sceSdVoiceTrans-style transfer at an explicit sound-RAM byte address.
+        void transferToSpu(uint32_t spuByteAddress, const uint8_t *source, size_t bytes);
+        void transferFromSpu(uint32_t spuByteAddress, uint8_t *destination, size_t bytes);
+        [[nodiscard]] bool admaActive(int core) const noexcept;
+
+        // Advances to the given IOP cycle, producing output samples. Returns true if an SPU2
+        // interrupt (IOP IRQ 9) was raised.
+        bool advanceTo(uint64_t iopCycle);
+
+        [[nodiscard]] Spu2OutputRing &output() noexcept { return m_output; }
+
+    private:
+        struct Voice
+        {
+            bool active = false;
+            uint32_t addr = 0;      // current block (halfword index)
+            uint32_t loopAddr = 0;  // LSAX
+            bool loopSetByHost = false;
+            uint32_t counter = 0;   // 12-bit fractional sample position
+            int16_t buffer[28]{};
+            int32_t prev1 = 0, prev2 = 0;
+            uint32_t bufferPos = 28;
+            uint8_t blockFlags = 0;
+            int16_t lastSample = 0;
+            int16_t interpPrev = 0;
+            // envelope
+            enum class Phase { Off, Attack, Decay, Sustain, Release } phase = Phase::Off;
+            int32_t env = 0;
+            uint32_t envWait = 0;
+            int32_t output = 0;
+        };
+
+        struct Core
+        {
+            Voice voices[24];
+            std::vector<int16_t> admaL, admaR;
+            size_t admaRead = 0;
+            bool admaPrimed = false;
+            std::vector<uint8_t> admaPartial; // bytes of an incomplete 1024-byte L/R block
+        };
+
+        uint16_t &reg(uint32_t offset) noexcept { return m_regs[(offset & (kRegSize - 1u)) >> 1u]; }
+        [[nodiscard]] uint32_t reg32(uint32_t hiOffset) const noexcept
+        {
+            return ((static_cast<uint32_t>(raw16(hiOffset)) & 0xFu) << 16u) | raw16(hiOffset + 2u);
+        }
+        void setReg32(uint32_t hiOffset, uint32_t value) noexcept
+        {
+            setRaw16(hiOffset, static_cast<uint16_t>((value >> 16u) & 0xFu));
+            setRaw16(hiOffset + 2u, static_cast<uint16_t>(value));
+        }
+
+        void keyOn(int core, int voice);
+        void keyOff(int core, int voice);
+        void decodeBlock(int core, int voice);
+        int32_t stepVoice(int core, int voice, int32_t prevVoiceOut);
+        void stepEnvelope(int core, int voice);
+        void checkIrq(int core, uint32_t addr, uint32_t count);
+        void mixSample();
+        void writeSpuRam(uint32_t &tsa, const uint8_t *source, size_t bytes, int core);
+        void pushAdma(int core, const uint8_t *source, size_t bytes);
+
+        std::vector<uint16_t> m_ram;
+        std::array<uint16_t, kRegSize / 2u> m_regs{};
+        Core m_cores[2];
+        uint64_t m_cycle = 0;
+        bool m_cycleInit = false;
+        bool m_irqPending = false;
+        uint32_t m_noise = 1;
+        Spu2OutputRing m_output;
+    };
+}
