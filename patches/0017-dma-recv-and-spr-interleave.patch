         setReturnU32(ctx, oldAddr);
     }
 
+    // sceDmaRecv/RecvN/RecvI(chan, addr, size): start a transfer from the channel into memory
+    // (DIR=0) in chain, normal or interleave mode, the way libdma programs the channel
+    // registers. The channel's other registers (SADR for fromSPR, D_SQWC for interleave)
+    // are set by the game beforehand.
+    int32_t submitDmaRecv(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime, uint32_t mode)
+    {
+        if (!runtime)
+        {
+            return -1;
+        }
+        const uint32_t channelBase = resolveDmaChannelBase(rdram, getRegU32(ctx, 4));
+        if (channelBase == 0)
+        {
+            return -1;
+        }
+        const uint32_t addr = toDmaPhys(getRegU32(ctx, 5));
+        PS2Memory &mem = runtime->memory();
+        if (mode == 1u)
+        {
+            mem.writeIORegister(channelBase + 0x20u, 0u);
+            mem.writeIORegister(channelBase + 0x30u, addr);
+        }
+        else
+        {
+            mem.writeIORegister(channelBase + 0x20u, normalizeQwcFromArg(getRegU32(ctx, 6)) & 0xFFFFu);
+            mem.writeIORegister(channelBase + 0x10u, addr);
+        }
+        mem.writeIORegister(channelBase + 0x00u, 0x00000180u | (mode << 2)); // DIR=0, TIE=1, STR=1
+        mem.processPendingTransfers();
+        (void)mem.consumeCompletedDmacCauses();
+        return 0;
+    }
+
     void sceDmaRecv(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        TODO_NAMED("sceDmaRecv", rdram, ctx, runtime);
