+void GSCpuBackend::SubmitBatches(const GSPrimitiveBatch *const *batches, size_t count)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram || count == 0u)
+        return;
+
+    RasterPool &pool = RasterPool::instance();
+    const unsigned participants = pool.participants();
+    if (participants <= 1u)
+    {
+        for (size_t i = 0; i < count; ++i)
+            if (batches[i]->vertexCount != 0u)
+                DrawPrimitive(*batches[i]);
+        return;
+    }
+
+    std::vector<PrimitiveFootprint> footprints;
+    std::vector<VramRange> segmentReads;
+    std::vector<WriteTarget> segmentWrites;
+    footprints.reserve(count);
+
+    size_t begin = 0u;
+    while (begin < count)
+    {
+        // Grow a segment of primitives that don't interact through VRAM except by drawing to
+        // the same buffers with the same layout (which keeps every pixel in one band).
+        footprints.clear();
+        segmentReads.clear();
+        segmentWrites.clear();
+        uint64_t segmentArea = 0u;
+        size_t end = begin;
+        while (end < count)
+        {
+            const GSPrimitiveBatch &batch = *batches[end];
+            PrimitiveFootprint fp = footprintOf(batch);
+            bool hazard = false;
+            if (fp.hasTexture)
+                for (const WriteTarget &w : segmentWrites)
+                    hazard = hazard || rangesOverlap(fp.texture, w.range);
+            for (int t = 0; t < fp.targetCount && !hazard; ++t)
+            {
+                const WriteTarget &target = fp.targets[t];
+                for (const VramRange &r : segmentReads)
+                    hazard = hazard || rangesOverlap(target.range, r);
+                for (const WriteTarget &w : segmentWrites)
+                {
+                    const bool sameLayout = w.base == target.base && w.width == target.width && w.psm == target.psm;
+                    hazard = hazard || (!sameLayout && rangesOverlap(target.range, w.range));
+                }
+            }
+            if (hazard && end > begin)
+                break;
+            if (fp.hasTexture)
+                segmentReads.push_back(fp.texture);
+            for (int t = 0; t < fp.targetCount; ++t)
+            {
+                bool known = false;
+                for (const WriteTarget &w : segmentWrites)
+                    known = known || (w.base == fp.targets[t].base && w.width == fp.targets[t].width && w.psm == fp.targets[t].psm);
+                if (!known)
+                    segmentWrites.push_back(fp.targets[t]);
+            }
+            segmentArea += fp.area;
+            footprints.push_back(fp);
+            ++end;
+        }
+
+        if (segmentArea < 16384u || end - begin == 0u)
+        {
+            for (size_t i = begin; i < end; ++i)
+                if (batches[i]->vertexCount != 0u)
+                    DrawPrimitive(*batches[i]);
+        }
+        else
+        {
+            const std::function<void(unsigned)> job = [&](unsigned index)
+            {
+                thread_local GSMem::TexturePageCache bandCache;
+                bandCache.Invalidate();
+                tl_bandTextureCache = &bandCache;
+                for (size_t i = begin; i < end; ++i)
+                {
+                    const GSPrimitiveBatch &batch = *batches[i];
+                    const PrimitiveFootprint &fp = footprints[i - begin];
+                    if (batch.vertexCount == 0u || fp.maxY < fp.minY)
+                        continue;
+                    for (int band = fp.minY / kBandRows; band <= fp.maxY / kBandRows; ++band)
+                    {
+                        if (static_cast<unsigned>(band) % participants != index)
+                            continue;
+                        GSPrimitiveBatch clipped = batch;
+                        GSScissorReg &scissor = clipped.state.context.scissor;
+                        scissor.y0 = static_cast<uint16_t>(std::max<int>(scissor.y0, band * kBandRows));
+                        scissor.y1 = static_cast<uint16_t>(std::min<int>(scissor.y1, band * kBandRows + kBandRows - 1));
+                        if (scissor.y0 <= scissor.y1)
+                            DrawPrimitive(clipped);
+                    }
+                }
+                tl_bandTextureCache = nullptr;
+            };
+            pool.run(job);
+            m_texturePageCache.Invalidate();
+        }
+        begin = end;
+    }
+}
