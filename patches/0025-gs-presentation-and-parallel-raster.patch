+namespace
+{
+    // Fixed pool of helper threads for band-parallel rasterisation.
+    class RasterPool
+    {
+    public:
+        static RasterPool &instance()
+        {
+            static RasterPool pool;
+            return pool;
+        }
+
+        unsigned participants() const noexcept { return static_cast<unsigned>(m_threads.size()) + 1u; }
+
+        // Calls job(index) once for every index in [0, participants()); the caller runs index 0.
+        void run(const std::function<void(unsigned)> &job)
+        {
+            if (m_threads.empty())
+            {
+                job(0u);
+                return;
+            }
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_job = &job;
+                m_remaining = static_cast<unsigned>(m_threads.size());
+                ++m_generation;
+            }
+            m_start.notify_all();
+            job(0u);
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_done.wait(lock, [this]()
+                        { return m_remaining == 0u; });
+            m_job = nullptr;
+        }
+
+    private:
+        RasterPool()
+        {
+            unsigned count = 0u;
+            if (const char *env = std::getenv("PS2X_GS_THREADS"))
+            {
+                count = static_cast<unsigned>(std::max(1l, std::strtol(env, nullptr, 10)));
+            }
+            else
+            {
+                // Leave a core each for the EE and the host/presentation thread.
+                const unsigned hw = std::thread::hardware_concurrency();
+                count = hw > 2u ? hw - 2u : 1u;
+            }
+            count = std::min(count, 16u);
+            for (unsigned i = 1u; i < count; ++i)
+                m_threads.emplace_back([this, i]()
+                                       { workerLoop(i); });
+        }
+
+        ~RasterPool()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_stop = true;
+            }
+            m_start.notify_all();
+            for (std::thread &thread : m_threads)
+                thread.join();
+        }
+
+        void workerLoop(unsigned index)
+        {
+            uint64_t seen = 0u;
+            for (;;)
+            {
+                const std::function<void(unsigned)> *job = nullptr;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_start.wait(lock, [&]()
+                                 { return m_stop || m_generation != seen; });
+                    if (m_stop)
+                        return;
+                    seen = m_generation;
+                    job = m_job;
+                }
+                (*job)(index);
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    --m_remaining;
+                }
+                m_done.notify_one();
+            }
+        }
+
+        std::vector<std::thread> m_threads;
+        std::mutex m_mutex;
+        std::condition_variable m_start;
+        std::condition_variable m_done;
+        const std::function<void(unsigned)> *m_job = nullptr;
+        uint64_t m_generation = 0u;
+        unsigned m_remaining = 0u;
+        bool m_stop = false;
+    };
+
+    constexpr uint32_t kVramBytes = 4u * 1024u * 1024u;
+    constexpr uint32_t kPageBytes = 8192u;
+    constexpr int kBandRows = 16;
+
+    struct VramRange
+    {
+        uint32_t begin = 0u;
+        uint32_t end = 0u; // exclusive; > kVramBytes means the range wraps and overlaps anything
+    };
+
+    bool rangesOverlap(const VramRange &a, const VramRange &b)
+    {
+        if (a.end > kVramBytes || b.end > kVramBytes)
+            return true;
+        return a.begin < b.end && b.begin < a.end;
+    }
+
+    void pageDims(uint8_t psm, uint32_t &width, uint32_t &height)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            width = 64u;
+            height = 64u;
+            return;
+        case GS_PSM_T8:
+            width = 128u;
+            height = 64u;
+            return;
+        case GS_PSM_T4:
+            width = 128u;
+            height = 128u;
+            return;
+        default: // 32-bit layouts, including T8H/T4HL/T4HH
+            width = 64u;
+            height = 32u;
+            return;
+        }
+    }
+
+    // Conservative page-granular range of a buffer `widthPixels` wide and `rows` tall.
+    VramRange bufferRange(uint32_t baseBlock, uint32_t widthPixels, uint32_t rows, uint8_t psm)
+    {
+        uint32_t pw = 64u, ph = 32u;
+        pageDims(psm, pw, ph);
+        const uint32_t begin = (baseBlock * 256u) & ~(kPageBytes - 1u);
+        const uint64_t pagesPerRow = std::max<uint64_t>(1u, (static_cast<uint64_t>(widthPixels) + pw - 1u) / pw);
+        const uint64_t pageRows = std::max<uint64_t>(1u, (static_cast<uint64_t>(rows) + ph - 1u) / ph);
+        const uint64_t end = static_cast<uint64_t>(begin) + (pagesPerRow * pageRows + 1u) * kPageBytes;
+        return VramRange{begin, static_cast<uint32_t>(std::min<uint64_t>(end, 0xFFFFFFFFull))};
+    }
+
+    struct WriteTarget
+    {
+        uint32_t base = 0u;
+        uint32_t width = 0u;
+        uint8_t psm = 0u;
+        VramRange range;
+    };
+
+    struct PrimitiveFootprint
+    {
+        int minY = 0;
+        int maxY = -1;
+        bool hasTexture = false;
+        VramRange texture;
+        WriteTarget targets[2];
+        int targetCount = 0;
+        uint64_t area = 0u;
+    };
+
+    PrimitiveFootprint footprintOf(const GSPrimitiveBatch &batch)
+    {
+        PrimitiveFootprint fp;
+        const GSDrawState &state = batch.state;
+        const GSContext &ctx = state.context;
+        const int count = std::max<int>(1, std::min<int>(batch.vertexCount, 3));
+        float minXf = batch.vertices[0].x, maxXf = minXf;
+        float minYf = batch.vertices[0].y, maxYf = minYf;
+        for (int i = 1; i < count; ++i)
+        {
+            minXf = std::min(minXf, batch.vertices[i].x);
+            maxXf = std::max(maxXf, batch.vertices[i].x);
+            minYf = std::min(minYf, batch.vertices[i].y);
+            maxYf = std::max(maxYf, batch.vertices[i].y);
+        }
+        const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+        const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+        const int minX = std::max<int>(ctx.scissor.x0, static_cast<int>(std::floor(minXf - ofx)) - 1);
+        const int maxX = std::min<int>(ctx.scissor.x1, static_cast<int>(std::ceil(maxXf - ofx)) + 1);
+        fp.minY = std::max<int>(ctx.scissor.y0, static_cast<int>(std::floor(minYf - ofy)) - 1);
+        fp.maxY = std::min<int>(ctx.scissor.y1, static_cast<int>(std::ceil(maxYf - ofy)) + 1);
+        if (maxX >= minX && fp.maxY >= fp.minY)
+            fp.area = static_cast<uint64_t>(maxX - minX + 1) * static_cast<uint64_t>(fp.maxY - fp.minY + 1);
+
+        const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u) * 64u;
+        const uint32_t rows = static_cast<uint32_t>(std::max<int>(ctx.scissor.y1, 0)) + 1u;
+        if (ctx.frame.fbmsk != 0xFFFFFFFFu)
+        {
+            const uint32_t base = framePageBaseToBlock(ctx.frame.fbp);
+            fp.targets[fp.targetCount++] = WriteTarget{base, fbw, ctx.frame.psm, bufferRange(base, fbw, rows, ctx.frame.psm)};
+        }
+        if (!ctx.zbuf.zmask)
+        {
+            const uint32_t base = framePageBaseToBlock(ctx.zbuf.zbp);
+            fp.targets[fp.targetCount++] = WriteTarget{base, fbw, ctx.zbuf.psm, bufferRange(base, fbw, rows, ctx.zbuf.psm)};
+        }
+        if (state.prim.tme)
+        {
+            fp.hasTexture = true;
+            const uint32_t texWidth = std::max<uint32_t>(std::max<uint32_t>(ctx.tex0.tbw, 1u) * 64u, state.textureWidth);
+            fp.texture = bufferRange(ctx.tex0.tbp0, texWidth, std::max<uint32_t>(state.textureHeight, 1u), ctx.tex0.psm);
+        }
+        return fp;
+    }
+}
